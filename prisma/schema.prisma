// MongoDB datasource.
//
// Prisma does not support `prisma migrate` against MongoDB, so the schema is
// applied with `prisma db push` (see package.json). MongoDB also has no
// autoincrement: Order.sequence is allocated from the Counter collection using
// an atomic findAndModify in src/lib/orders.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String
  name      String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id                String      @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  slug              String      @unique
  shortDescription  String
  fullDescription   String
  // Money is stored as whole rupees. Every price in this catalogue is an
  // integer, and Int avoids the Decimal128 conversion surprises of Decimal.
  price             Int
  compareAtPrice    Int?
  weight            String
  sku               String      @unique
  stockQuantity     Int         @default(0)
  lowStockThreshold Int         @default(5)
  images            String
  ingredients       String
  nutritionInfo     String
  storageInfo       String
  shelfLife         String
  howToUse          String
  faq               String
  status            String      @default("active")
  featured          Boolean     @default(false)
  bestSeller        Boolean     @default(false)
  sortOrder         Int         @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  orderItems        OrderItem[]
}

model Coupon {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  code               String   @unique
  discountType       String // "percentage" | "fixed"
  discountValue      Int
  minimumOrderAmount Int?
  usageLimit         Int?
  usedCount          Int      @default(0)
  expiresAt          DateTime?
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  orders             Order[]
}

// Replaces the Postgres sequence. Each document is a named counter whose value
// is incremented atomically by MongoDB itself, so concurrent checkouts can never
// be handed the same number.
model Counter {
  // A plain string key, so the document id can be "order-2026-10-05" rather than
  // an ObjectId. @map("_id") is still required for MongoDB.
  id        String   @id @map("_id")
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Order {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Human-facing order number, built from the sequence counter and written in the
  // same insert, so the row is never visible without it. Required rather than
  // optional: MongoDB stores a missing field as null, and a plain unique index
  // only tolerates one such document, so a nullable unique id would break the
  // second pending order outright.
  orderId  String @unique
  sequence Int    @unique
  status   String @default("open")

  // Customer. Email is deliberately optional: checkout does not require it.
  customerName   String
  customerPhone  String
  customerEmail  String?
  address        String
  city           String
  state          String
  postalCode     String
  country        String  @default("India")

  items OrderItem[]

  subtotal    Int
  discount    Int @default(0)
  deliveryFee Int @default(0)
  total       Int

  // Payment
  paymentMethod      String  @default("razorpay")
  paymentStatus      String  @default("pending") // pending | paid | failed | refunded
  paymentVerified    Boolean @default(false)
  // paymentId and razorpayOrderId are deliberately NOT @unique. Both start unset
  // on a pending order, and a MongoDB unique index treats every absent field as
  // null, so a unique index here would allow exactly one pending order in the
  // whole database. Uniqueness of paymentId is enforced in confirmPaidOrder
  // instead, which is the only place that sets it.
  paymentId          String?
  razorpayOrderId    String?
  razorpaySignature  String?
  paymentFailureCode String?

  // Fulfilment
  orderStatus    String   @default("pending") // pending | confirmed | processing | packed | shipped | out_for_delivery | delivered | cancelled
  deliveryStatus String   @default("pending")
  trackingNumber String?
  deliveryNotes  String?

  // The applied code is kept verbatim for the receipt. MongoDB relations can only
  // target an @id field, so the link to Coupon points at ObjectId while couponCode
  // preserves what the customer actually typed.
  couponCode String?
  couponId   String? @db.ObjectId
  coupon     Coupon? @relation(fields: [couponId], references: [id])
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([paymentStatus])
  @@index([orderStatus])
  @@index([customerPhone])
  @@index([razorpayOrderId])
  @@index([paymentId])
}

model OrderItem {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  orderId String @db.ObjectId
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Product catalogue is currently code-owned (src/lib/products.ts), so the
  // stable slug is what we persist. productId stays optional for when the
  // catalogue moves into the database.
  productId   String?   @db.ObjectId
  product     Product?  @relation(fields: [productId], references: [id])
  productSlug String
  name        String
  image       String?
  quantity    Int
  mrp         Int
  unitPrice   Int
  lineTotal   Int
}