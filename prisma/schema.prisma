generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id                String      @id @default(cuid())
  name              String
  slug              String      @unique
  shortDescription  String
  fullDescription   String
  price             Decimal
  compareAtPrice    Decimal?
  weight            String
  sku               String      @unique
  stockQuantity     Int         @default(0)
  lowStockThreshold Int         @default(5)
  images            String
  ingredients       String
  nutritionInfo     String
  storageInfo       String
  shelfLife         String
  howToUse          String
  faq               String
  status            String      @default("active")
  featured          Boolean     @default(false)
  bestSeller        Boolean     @default(false)
  sortOrder         Int         @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  orderItems        OrderItem[]
}

model Coupon {
  id                 String   @id @default(cuid())
  code               String   @unique
  discountType       String // "percentage" | "fixed"
  discountValue      Decimal
  minimumOrderAmount Decimal?
  usageLimit         Int?
  usedCount          Int      @default(0)
  expiresAt          DateTime?
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  orders             Order[]
}

model Order {
  id String @id @default(cuid())

  // Human-facing order number. Left null while the row is still being created so
  // Postgres assigns the sequence first, then we build NCJ-YYYYMMDD-000123 from
  // it. Postgres unique constraints guarantee no two orders share an ID.
  orderId  String? @unique
  sequence Int     @unique @default(autoincrement())
  status   String  @default("open")

  // Customer. Email is deliberately optional: checkout does not require it.
  customerName   String
  customerPhone  String
  customerEmail  String?
  address        String
  city           String
  state          String
  postalCode     String
  country        String  @default("India")

  items OrderItem[]

  subtotal    Decimal
  discount    Decimal  @default(0)
  deliveryFee Decimal  @default(0)
  total       Decimal

  // Payment
  paymentMethod      String  @default("razorpay")
  paymentStatus      String  @default("pending") // pending | paid | failed | refunded
  paymentVerified    Boolean @default(false)
  paymentId          String? @unique
  razorpayOrderId    String? @unique
  razorpaySignature  String?
  paymentFailureCode String?

  // Fulfilment
  orderStatus    String   @default("pending") // pending | confirmed | processing | packed | shipped | out_for_delivery | delivered | cancelled
  deliveryStatus String   @default("pending")
  trackingNumber String?
  deliveryNotes  String?

  couponCode String?
  coupon     Coupon? @relation(fields: [couponCode], references: [code])
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([paymentStatus])
  @@index([orderStatus])
  @@index([customerPhone])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Product catalogue is currently code-owned (src/lib/products.ts), so the
  // stable slug is what we persist. productId stays optional for when the
  // catalogue moves into Postgres.
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  productSlug String
  name        String
  image       String?
  quantity    Int
  mrp         Decimal
  unitPrice   Decimal
  lineTotal   Decimal
}