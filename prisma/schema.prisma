// MongoDB datasource.
//
// Prisma does not support `prisma migrate` against MongoDB, so the schema is
// applied with `prisma db push` (see package.json). MongoDB also has no
// autoincrement: Order.sequence is allocated from the Counter collection using
// an atomic findAndModify in src/lib/orders.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String
  name      String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id                String      @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  slug              String      @unique
  shortDescription  String
  fullDescription   String
  // Money is stored as whole rupees. Every price in this catalogue is an
  // integer, and Int avoids the Decimal128 conversion surprises of Decimal.
  price             Int
  compareAtPrice    Int?
  weight            String
  sku               String      @unique
  stockQuantity     Int         @default(0)
  lowStockThreshold Int         @default(5)
  images            String
  ingredients       String
  nutritionInfo     String
  storageInfo       String
  shelfLife         String
  howToUse          String
  faq               String
  status            String      @default("active")
  featured          Boolean     @default(false)
  bestSeller        Boolean     @default(false)
  sortOrder         Int         @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  orderItems        OrderItem[]
}

model Coupon {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  code               String   @unique
  discountType       String // "percentage" | "fixed"
  discountValue      Int
  minimumOrderAmount Int?
  usageLimit         Int?
  usedCount          Int      @default(0)
  expiresAt          DateTime?
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  orders             Order[]
}

// Replaces the Postgres sequence. Each document is a named counter whose value
// is incremented atomically by MongoDB itself, so concurrent checkouts can never
// be handed the same number.
model Counter {
  // A plain string key, so the document id can be "order-2026-10-05" rather than
  // an ObjectId. @map("_id") is still required for MongoDB.
  id        String   @id @map("_id")
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Order {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Human-facing order number, built from the sequence counter and written in the
  // same insert, so the row is never visible without it. Required rather than
  // optional: MongoDB stores a missing field as null, and a plain unique index
  // only tolerates one such document, so a nullable unique id would break the
  // second pending order outright.
  orderId  String @unique
  sequence Int    @unique
  status   String @default("open")

  // Customer. Email is deliberately optional: checkout does not require it.
  customerName   String
  customerPhone  String
  customerEmail  String?
  address        String
  city           String
  state          String
  postalCode     String
  country        String  @default("India")

  items OrderItem[]

  subtotal    Int
  discount    Int @default(0)
  deliveryFee Int @default(0)
  total       Int

  // Payment
  paymentMethod      String  @default("razorpay")
  paymentStatus      String  @default("pending") // pending | paid | failed | refunded
  paymentVerified    Boolean @default(false)
  // paymentId and razorpayOrderId are deliberately NOT @unique. Both start unset
  // on a pending order, and a MongoDB unique index treats every absent field as
  // null, so a unique index here would allow exactly one pending order in the
  // whole database. Uniqueness of paymentId is enforced in confirmPaidOrder
  // instead, which is the only place that sets it.
  paymentId          String?
  razorpayOrderId    String?
  razorpaySignature  String?
  paymentFailureCode String?

  // Fulfilment
  orderStatus    String   @default("pending") // pending | confirmed | processing | packed | shipped | out_for_delivery | delivered | cancelled
  deliveryStatus String   @default("pending")
  trackingNumber String?
  deliveryNotes  String?

  // The applied code is kept verbatim for the receipt. MongoDB relations can only
  // target an @id field, so the link to Coupon points at ObjectId while couponCode
  // preserves what the customer actually typed.
  couponCode String?
  couponId   String? @db.ObjectId
  coupon     Coupon? @relation(fields: [couponId], references: [id])
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([paymentStatus])
  @@index([orderStatus])
  @@index([customerPhone])
  @@index([razorpayOrderId])
  @@index([paymentId])
}

// ---------------------------------------------------------------------------
// Reference data owned by the catalogue service that seeded this database.
//
// These collections already exist in MongoDB with real records, and they use
// their own field names — lowercase collection names, prices in paise, image
// objects rather than a path string, isActive rather than status. The models
// below are read-only mirrors of the shape those documents actually have; every
// required field was verified to be present in every document of its collection
// before it was declared required, so a read can never fail on a missing field.
//
// They are deliberately NOT mapped onto User/Product/Coupon/Order above. Those
// models are this application's own write path, and mixing two writers into one
// collection would let a foreign document break a checkout.
//
// Nothing here writes. `prisma db push` is not needed to read them.
// ---------------------------------------------------------------------------

model CatalogProduct {
  id               String @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  slug             String @unique
  tagline          String
  shortDescription String
  description      String
  flavour          String
  sortOrder        Int
  isActive         Boolean
  isFeatured       Boolean
  isVerified       Boolean
  seoTitle         String
  seoDescription   String
  shelfLife        String
  storage          String
  fssaiNote        String

  // Complex values stay as Json: images are objects, the rest are arrays whose
  // element type the source service never declared. Json accepts either, so a
  // later document with a different element type still reads.
  images        Json
  ogImage       Json
  marketplace   Json
  nutritionPer  Json
  allergens     Json
  ingredients   Json
  howToUse      Json
  nutrition     Json

  // Storefront presentation fields. Optional rather than required so a document
  // written before they existed still reads; the loader falls back to a sensible
  // value for every one of them.
  //
  // ingredientsText carries the sentence the product page prints. The older
  // `ingredients` array above is left untouched: it belongs to the service that
  // seeded this collection and was empty in every document.
  variantName    String?
  shortName      String?
  flavourNote    String?
  highlights     Json?
  ingredientsText String?
  weight         String?
  pack           String?
  imagePaths     Json?

  createdAt DateTime
  updatedAt DateTime

  variants ProductVariant[]

  @@map("products")
}

model ProductVariant {
  id               String @id @default(auto()) @map("_id") @db.ObjectId
  productId        String @db.ObjectId
  product          CatalogProduct @relation(fields: [productId], references: [id])
  sku              String @unique
  weightGrams      Int
  weightLabel      String
  packCount        Int
  pricePaise       Int
  // Null while a variant has no separate MRP, which is how all nine read today.
  mrpPaise         Int?
  inventory        Int
  lowStockThreshold Int
  isActive         Boolean
  sortOrder        Int
  createdAt        DateTime
  updatedAt        DateTime

  @@map("productvariants")
}

model BusinessSettings {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  brandName         String
  tagline           String
  announcement      String
  description       String
  currency          String
  defaultOgImageUrl String

  supportEmail  String
  supportPhone  String
  whatsappNumber String

  instagramHandle String
  twitterHandle   String
  social          Json
  notifications   Json
  logo            Json?

  legalName   String
  gstNumber   String
  fssaiNumber String
  cinNumber   String

  businessAddressLine1 String
  businessAddressLine2 String
  businessCity         String
  businessState        String
  businessPincode      String
  businessCountry      String
  businessHours        String

  onlinePaymentEnabled Boolean
  razorpayDisplayName  String

  isVerified Boolean
  createdAt  DateTime
  updatedAt  DateTime

  @@map("businesssettings")
}

/**
 * Every editable block of copy on the storefront — hero banner, trust strip,
 * section headings, bullet lists, the footer blurb. One document per section,
 * addressed by `key`.
 *
 * `label` is the name shown to the admin, `key` is what the component asks for.
 * The scalar fields cover a headline plus paragraphs; `items` covers bullet
 * lists, steps, FAQs and reviews, and `links` covers the buttons under a
 * heading. Both stay Json because their element shapes differ per section.
 *
 * Nothing here was created by `db push` — the collection is populated by the
 * one-time seed and written by the admin editor, so a missing or empty
 * collection simply means each component renders the copy it shipped with.
 */
model Section {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String
  label       String
  eyebrow     String
  title       String
  titleAccent String
  body        String
  body2       String
  image       String
  items       Json
  links       Json
  createdAt   DateTime
  updatedAt   DateTime

  @@index([key])
  @@map("sections")
}

model ShippingConfiguration {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  configVersion Int
  shippingEnabled       Boolean
  shippingDisabledMessage String
  shippingPolicyNote    String

  flatShippingPaise         Int
  handlingPaise             Int
  freeShippingEnabled       Boolean
  freeShippingThresholdPaise Int

  weightBasedShipping Boolean
  weightRatePaisePerKg Int
  maxWeightPerOrderGrams Int

  codEnabled        Boolean
  codHandlingPaise  Int
  codMaxOrderPaise  Int?

  taxEnabled    Boolean
  taxInclusive  Boolean
  taxPercent    Int

  serviceabilityMode    String
  serviceablePincodes   Json
  blockedPincodes       Json
  unknownPincodeMessage String
  unserviceableMessage  String

  showEstimatedDelivery       Boolean
  defaultEstimatedDeliveryDaysMin Int
  defaultEstimatedDeliveryDaysMax Int

  allowCancellation  Boolean
  cancelWindowHours  Int

  pickupName           String
  pickupContactName    String
  pickupContactPhone   String
  pickupEmail          String
  pickupAddressLine1   String
  pickupAddressLine2   String
  pickupCity           String
  pickupState          String
  pickupPincode        String
  pickupCountry        String

  createdAt DateTime
  updatedAt DateTime

  @@map("shippingconfigurations")
}

model OrderItem {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  orderId String @db.ObjectId
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Product catalogue is currently code-owned (src/lib/products.ts), so the
  // stable slug is what we persist. productId stays optional for when the
  // catalogue moves into the database.
  productId   String?   @db.ObjectId
  product     Product?  @relation(fields: [productId], references: [id])
  productSlug String
  name        String
  image       String?
  quantity    Int
  mrp         Int
  unitPrice   Int
  lineTotal   Int
}