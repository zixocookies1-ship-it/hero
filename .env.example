# ─────────────────────────────────────────────────────────────────────────────
# Database (server-only) — required. PostgreSQL (Vercel Postgres / Neon).
# Create the migration once with: npm run db:deploy
# Local dev example:
#   postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
# DATABASE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Razorpay — required for checkout.
#   RAZORPAY_KEY_ID     server-only, Test mode key
#   RAZORPAY_KEY_SECRET server-only, never exposed to the browser
#   NEXT_PUBLIC_RAZORPAY_KEY_ID must equal RAZORPAY_KEY_ID (client Checkout.js)
# Test keys: https://dashboard.razorpay.com/app/keys  (mode: Test)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ─────────────────────────────────────────────────────────────────────────────
# Order signing (server-only) — required.
# Signs admin session cookies and customer receipt links.
# Generate: openssl rand -hex 32
# Falls back to AUTH_SECRET, then RAZORPAY_KEY_SECRET if unset.
# ORDER_SIGNING_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Admin login (server-only) — required to reach /admin.
# ADMIN_EMAIL is the login handle; ADMIN_PASSWORD must be >= 8 characters.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# Shipping (server-only) — the cart never sends amounts; these drive pricing.
# SHIPPING_FEE_INR=49
# Optional: waive delivery above this order subtotal (blank = always charge).
# FREE_SHIPPING_THRESHOLD_INR=

# ─────────────────────────────────────────────────────────────────────────────
# App
# NEXT_PUBLIC_SITE_URL=https://hero-pi-seven.vercel.app
NEXT_PUBLIC_WHATSAPP_NUMBER=8805551680

# Cloudinary (server-only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Delhivery (server-only)
DELHIVERY_API_KEY=
DELHIVERY_BASE_URL=
DELHIVERY_CLIENT_ID=

# Contact webhook (server-only) — only used by /api/contact. The contact form
# itself now hands off to WhatsApp and does not post here.
CONTACT_WEBHOOK_URL=

# Analytics (server-only)
META_CAPI_ACCESS_TOKEN=

# Auth (server-only) — fallback for ORDER_SIGNING_SECRET
AUTH_SECRET=
